{
  "version": "2.0.0",
  "tasks": [
    {"label": "Vision: build ESP32-S3", "type": "shell", "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/idf.ps1", "build"],
      "options": {"cwd": "${workspaceFolder}"}, "group": {"kind": "build", "isDefault": true}, "problemMatcher": ["$gcc"]},
    {"label": "Vision: simulation", "type": "shell", "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/simulate.ps1"],
      "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": ["$gcc"]},
    {"label": "Vision: image sequences", "type": "shell", "command": "python",
      "args": ["${workspaceFolder}/../simulator/sequence_simulation.py"],
      "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": ["$gcc"]}
  ]
}
